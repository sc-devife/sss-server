<!doctype html>
<html>
<body style="margin:0;padding:0;background:#f4f5f7;font-family:Arial,Helvetica,sans-serif;color:#1a222c;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;padding:24px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:8px;overflow:hidden;">
          <tr>
            <td style="background:#0d2645;padding:20px 28px;">
              <span style="color:#ffffff;font-size:16px;font-weight:700;">{{organizationName}}</span>
            </td>
          </tr>
          <tr>
            <td style="padding:28px;">
              <p style="margin:0 0 4px;font-size:19px;font-weight:700;color:#0d2645;">{{heading}}</p>
              <p style="margin:0 0 20px;font-size:14px;line-height:1.6;color:#4a5666;">{{introText}}</p>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;border-radius:6px;margin:0 0 20px;">
                <tr>
                  <td style="padding:16px 20px;">
                    <p style="margin:0 0 8px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;color:#8290a0;">{{recordLabel}}</p>
                    <p style="margin:0 0 12px;font-size:14px;line-height:1.6;color:#1a222c;">{{comment}}</p>
                    {{#hasDueAt}}
                    <p style="margin:0;font-size:13px;color:#4a5666;"><strong>Due:</strong> {{dueAtDisplay}}</p>
                    {{/hasDueAt}}
                  </td>
                </tr>
              </table>

              <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0;">
                <tr>
                  <td style="border-radius:6px;background:#0d2645;">
                    <a href="{{recordLink}}" target="_blank"
                       style="display:inline-block;padding:14px 32px;font-size:15px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:6px;">
                      View in CRM
                    </a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
