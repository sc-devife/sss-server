<!doctype html>
<html>
<body style="margin:0;padding:0;background:#f4f5f7;font-family:Arial,Helvetica,sans-serif;color:#1a222c;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;padding:24px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:8px;overflow:hidden;">
          <tr>
            <td style="background:#7a1f1f;padding:20px 28px;">
              <span style="color:#ffffff;font-size:16px;font-weight:700;">{{organizationName}}</span>
            </td>
          </tr>
          <tr>
            <td style="padding:28px;">
              <p style="margin:0 0 14px;font-size:14px;">Dear Sir/Madam,</p>
              <p style="margin:0 0 14px;font-size:14px;line-height:1.6;">
                Greetings from <strong>{{organizationName}}</strong>.
              </p>
              <p style="margin:0 0 20px;font-size:14px;line-height:1.6;">
                We regret to inform you that the below hotel booking has been <strong>CANCELLED</strong>. Please update your records accordingly.
              </p>

              <div style="margin:0 0 8px;font-size:13px;font-weight:700;color:#7a1f1f;text-transform:uppercase;letter-spacing:.04em;">Escape Details</div>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 20px;border:1px solid #e5e8ec;border-radius:6px;">
                <tr>
                  <td style="padding:10px 18px;font-size:13px;color:#4a5666;width:40%;">Escape ID</td>
                  <td style="padding:10px 18px;font-size:13px;font-weight:700;">{{tripCode}}</td>
                </tr>
                <tr>
                  <td style="padding:10px 18px;font-size:13px;color:#4a5666;border-top:1px dashed #e5e8ec;">Escape Name</td>
                  <td style="padding:10px 18px;font-size:13px;font-weight:700;border-top:1px dashed #e5e8ec;">{{escapeName}}</td>
                </tr>
                {{#escapePoint}}
                <tr>
                  <td style="padding:10px 18px;font-size:13px;color:#4a5666;border-top:1px dashed #e5e8ec;">Escape Point</td>
                  <td style="padding:10px 18px;font-size:13px;font-weight:700;border-top:1px dashed #e5e8ec;">{{escapePoint}}</td>
                </tr>
                {{/escapePoint}}
                <tr>
                  <td style="padding:10px 18px;font-size:13px;color:#4a5666;border-top:1px dashed #e5e8ec;">Escape Dates</td>
                  <td style="padding:10px 18px;font-size:13px;font-weight:700;border-top:1px dashed #e5e8ec;">{{escapeStartDate}} to {{escapeEndDate}}</td>
                </tr>
              </table>

              <div style="margin:0 0 8px;font-size:13px;font-weight:700;color:#7a1f1f;text-transform:uppercase;letter-spacing:.04em;">Cancelled Hotel Booking</div>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 20px;border:1px solid #e5e8ec;border-radius:6px;">
                <tr>
                  <td style="padding:10px 18px;font-size:13px;color:#4a5666;width:40%;">Hotel Name</td>
                  <td style="padding:10px 18px;font-size:13px;font-weight:700;">{{hotelName}}</td>
                </tr>
                <tr>
                  <td style="padding:10px 18px;font-size:13px;color:#4a5666;border-top:1px dashed #e5e8ec;">Check-in</td>
                  <td style="padding:10px 18px;font-size:13px;font-weight:700;border-top:1px dashed #e5e8ec;">{{checkInDate}}</td>
                </tr>
                <tr>
                  <td style="padding:10px 18px;font-size:13px;color:#4a5666;border-top:1px dashed #e5e8ec;">Check-out</td>
                  <td style="padding:10px 18px;font-size:13px;font-weight:700;border-top:1px dashed #e5e8ec;">{{checkOutDate}}</td>
                </tr>
                {{#roomTypeName}}
                <tr>
                  <td style="padding:10px 18px;font-size:13px;color:#4a5666;border-top:1px dashed #e5e8ec;">Room Type</td>
                  <td style="padding:10px 18px;font-size:13px;font-weight:700;border-top:1px dashed #e5e8ec;">{{roomTypeName}}</td>
                </tr>
                {{/roomTypeName}}
                {{#cancellationReason}}
                <tr>
                  <td style="padding:10px 18px;font-size:13px;color:#4a5666;border-top:1px dashed #e5e8ec;vertical-align:top;">Reason</td>
                  <td style="padding:10px 18px;font-size:13px;font-weight:700;border-top:1px dashed #e5e8ec;">{{cancellationReason}}</td>
                </tr>
                {{/cancellationReason}}
                {{#totalAmountFormatted}}
                <tr>
                  <td style="padding:14px 18px;font-size:13px;color:#4a5666;border-top:1px dashed #e5e8ec;">Cancellation Charge</td>
                  <td style="padding:14px 18px;font-size:15px;font-weight:800;color:#7a1f1f;border-top:1px dashed #e5e8ec;">&#8377;{{totalAmountFormatted}}</td>
                </tr>
                {{/totalAmountFormatted}}
              </table>

              <p style="margin:24px 0 0;font-size:14px;">Please reach out to us if you have any questions regarding this cancellation.</p>
              <p style="margin:16px 0 0;font-size:14px;">Warm regards,<br><strong>{{organizationName}}</strong></p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
