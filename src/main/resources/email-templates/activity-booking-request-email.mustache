<!doctype html>
<html>
<body style="margin:0;padding:0;background:#f4f5f7;font-family:Arial,Helvetica,sans-serif;color:#1a222c;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;padding:24px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:8px;overflow:hidden;">
          <tr>
            <td style="background:#0d2645;padding:20px 28px;">
              <span style="color:#ffffff;font-size:16px;font-weight:700;">{{organizationName}}</span>
            </td>
          </tr>
          <tr>
            <td style="padding:28px;">
              <p style="margin:0 0 14px;font-size:14px;">Dear Sir/Madam,</p>
              <p style="margin:0 0 14px;font-size:14px;line-height:1.6;">
                Greetings from <strong>{{organizationName}}</strong>.
              </p>
              <p style="margin:0 0 20px;font-size:14px;line-height:1.6;">
                We are pleased to share the below activity booking details. We request you to please <strong>BOOK &amp; CONFIRM</strong> the same.
              </p>

              <div style="margin:0 0 8px;font-size:13px;font-weight:700;color:#0d2645;text-transform:uppercase;letter-spacing:.04em;">Escape Details</div>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 20px;border:1px solid #e5e8ec;border-radius:6px;">
                <tr>
                  <td style="padding:10px 18px;font-size:13px;color:#4a5666;width:40%;">Escape ID</td>
                  <td style="padding:10px 18px;font-size:13px;font-weight:700;">{{tripCode}}</td>
                </tr>
                <tr>
                  <td style="padding:10px 18px;font-size:13px;color:#4a5666;border-top:1px dashed #e5e8ec;">Escape Name</td>
                  <td style="padding:10px 18px;font-size:13px;font-weight:700;border-top:1px dashed #e5e8ec;">{{escapeName}}</td>
                </tr>
                {{#escapePoint}}
                <tr>
                  <td style="padding:10px 18px;font-size:13px;color:#4a5666;border-top:1px dashed #e5e8ec;">Escape Point</td>
                  <td style="padding:10px 18px;font-size:13px;font-weight:700;border-top:1px dashed #e5e8ec;">{{escapePoint}}</td>
                </tr>
                {{/escapePoint}}
                <tr>
                  <td style="padding:10px 18px;font-size:13px;color:#4a5666;border-top:1px dashed #e5e8ec;">Escape Dates</td>
                  <td style="padding:10px 18px;font-size:13px;font-weight:700;border-top:1px dashed #e5e8ec;">{{escapeStartDate}} to {{escapeEndDate}}</td>
                </tr>
              </table>

              <div style="margin:0 0 8px;font-size:13px;font-weight:700;color:#0d2645;text-transform:uppercase;letter-spacing:.04em;">Traveler Details</div>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 20px;border:1px solid #e5e8ec;border-radius:6px;">
                <tr>
                  <td style="padding:10px 18px;font-size:13px;color:#4a5666;width:40%;">Primary Traveler</td>
                  <td style="padding:10px 18px;font-size:13px;font-weight:700;">{{primaryTravellerName}}</td>
                </tr>
                {{#adultCount}}
                <tr>
                  <td style="padding:10px 18px;font-size:13px;color:#4a5666;border-top:1px dashed #e5e8ec;">Adults</td>
                  <td style="padding:10px 18px;font-size:13px;font-weight:700;border-top:1px dashed #e5e8ec;">{{adultCount}}</td>
                </tr>
                {{/adultCount}}
                {{#childCount}}
                <tr>
                  <td style="padding:10px 18px;font-size:13px;color:#4a5666;border-top:1px dashed #e5e8ec;">Children</td>
                  <td style="padding:10px 18px;font-size:13px;font-weight:700;border-top:1px dashed #e5e8ec;">{{childCount}}</td>
                </tr>
                {{/childCount}}
                {{#infantCount}}
                <tr>
                  <td style="padding:10px 18px;font-size:13px;color:#4a5666;border-top:1px dashed #e5e8ec;">Infants</td>
                  <td style="padding:10px 18px;font-size:13px;font-weight:700;border-top:1px dashed #e5e8ec;">{{infantCount}}</td>
                </tr>
                {{/infantCount}}
              </table>

              <div style="margin:0 0 8px;font-size:13px;font-weight:700;color:#0d2645;text-transform:uppercase;letter-spacing:.04em;">Activity Booking Details</div>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 20px;border:1px solid #e5e8ec;border-radius:6px;">
                <tr>
                  <td style="padding:10px 18px;font-size:13px;color:#4a5666;width:40%;">Activity Name</td>
                  <td style="padding:10px 18px;font-size:13px;font-weight:700;">{{activityName}}</td>
                </tr>
                {{#activityDate}}
                <tr>
                  <td style="padding:10px 18px;font-size:13px;color:#4a5666;border-top:1px dashed #e5e8ec;">Date</td>
                  <td style="padding:10px 18px;font-size:13px;font-weight:700;border-top:1px dashed #e5e8ec;">{{activityDate}}</td>
                </tr>
                {{/activityDate}}
                {{#startTime}}
                <tr>
                  <td style="padding:10px 18px;font-size:13px;color:#4a5666;border-top:1px dashed #e5e8ec;">Start Time</td>
                  <td style="padding:10px 18px;font-size:13px;font-weight:700;border-top:1px dashed #e5e8ec;">{{startTime}}</td>
                </tr>
                {{/startTime}}
                {{#durationMinutes}}
                <tr>
                  <td style="padding:10px 18px;font-size:13px;color:#4a5666;border-top:1px dashed #e5e8ec;">Duration</td>
                  <td style="padding:10px 18px;font-size:13px;font-weight:700;border-top:1px dashed #e5e8ec;">{{durationMinutes}} min</td>
                </tr>
                {{/durationMinutes}}
                {{#travelersCount}}
                <tr>
                  <td style="padding:10px 18px;font-size:13px;color:#4a5666;border-top:1px dashed #e5e8ec;">No. of Participants</td>
                  <td style="padding:10px 18px;font-size:13px;font-weight:700;border-top:1px dashed #e5e8ec;">{{travelersCount}}</td>
                </tr>
                {{/travelersCount}}
                {{#notes}}
                <tr>
                  <td style="padding:10px 18px;font-size:13px;color:#4a5666;border-top:1px dashed #e5e8ec;vertical-align:top;">Notes</td>
                  <td style="padding:10px 18px;font-size:13px;font-weight:700;border-top:1px dashed #e5e8ec;">{{notes}}</td>
                </tr>
                {{/notes}}
                {{#totalAmountFormatted}}
                <tr>
                  <td style="padding:14px 18px;font-size:13px;color:#4a5666;border-top:1px dashed #e5e8ec;">Rate / Total</td>
                  <td style="padding:14px 18px;font-size:15px;font-weight:800;color:#1f8a4c;border-top:1px dashed #e5e8ec;">&#8377;{{totalAmountFormatted}}</td>
                </tr>
                {{/totalAmountFormatted}}
              </table>

              <p style="margin:24px 0 0;font-size:14px;">Kindly confirm the above booking at your earliest convenience.</p>
              <p style="margin:16px 0 0;font-size:14px;">Warm regards,<br><strong>{{organizationName}}</strong></p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
